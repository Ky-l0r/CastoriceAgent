# ============================================================
#  .gitattributes —— 统一换行符与二进制判定
# ============================================================
#  背景：本机 core.autocrlf=true，而 CI 在 Linux 上跑 ruff format 检查。
#  没有本文件时，换行符取决于每个人的 git 配置，容易出现
#  「本地全绿、CI 报格式错」以及整文件 diff 的情况。
#
#  规则：源码与文本一律 LF 入库；Windows 脚本保留 CRLF；二进制不做转换。
#  改动后如需立即对齐已有文件：
#      git add --renormalize .
# ============================================================

# 默认：自动判定文本，入库统一 LF
* text=auto eol=lf

# ---- 源码与文档（LF）----
*.py    text eol=lf
*.pyi   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.spec  text eol=lf

# ---- Windows 脚本（CRLF，避免 cmd/powershell 解析问题）----
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# ---- 二进制（禁止任何转换，否则文件损坏）----
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.bmp     binary
*.onnx    binary
*.bin     binary
*.dat     binary
*.sqlite3 binary
*.db      binary
*.zip     binary
*.7z      binary
*.exe     binary
*.dll     binary
*.pyd     binary
*.pak     binary

# ---- 锁文件：不做 diff 展开，减少噪音 ----
pnpm-lock.yaml     -diff linguist-generated
webapp/pnpm-lock.yaml -diff linguist-generated
