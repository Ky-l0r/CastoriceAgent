{
  "name": "castorice-webapp",
  "productName": "CastoriceAgent",
  "version": "0.1.0",
  "private": true,
  "description": "CastoriceAgent 第三期：Electron 壳 + Web UI",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite build --config vite.config.ts && cross-env VITE_DEV=1 electron .",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "start": "electron .",
    "check:renderer": "tsc -p tsconfig.json --noEmit",
    "check:main": "tsc -p tsconfig.main.json --noEmit",
    "check:preload": "tsc -p tsconfig.preload.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "jotai": "^2.15.0",
    "lucide-react": "^1.32.0",
    "motion": "^13.4.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.10"
  }
}
